{
  "expo": {
    "name": "EduCore Guru",
    "slug": "educore-guru",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "educore",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#0F172A",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "id.sch.educore.guru"
    },
    "android": {
      "package": "id.sch.educore.guru",
      "adaptiveIcon": {
        "backgroundColor": "#0F172A"
      }
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#C8102E"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "EduCore memakai kamera untuk memindai kode QR pembayaran kantin."
        }
      ]
    ],
    "extra": {
      "apiUrl": "http://10.0.2.2:8000/api/v1"
    }
  }
}
