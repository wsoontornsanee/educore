{
  "expo": {
    "name": "EduCore Guru",
    "slug": "educore-guru",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "educore",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#0F172A",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "id.sch.educore.guru"
    },
    "android": {
      "package": "id.sch.educore.guru",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#C8102E"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#C8102E"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "EduCore memakai kamera untuk memindai kode QR pembayaran kantin."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "68d7a971-c1e9-4c74-aa01-dc4f588f486e"
      }
    },
    "owner": "nat.wutti"
  }
}
