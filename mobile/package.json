{
  "name": "educore-guru",
  "version": "1.0.0",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "node --test __tests__/**/*.test.ts"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "expo": "~51.0.0",
    "expo-constants": "~16.0.2",
    "expo-local-authentication": "~14.0.1",
    "expo-notifications": "~0.28.1",
    "expo-secure-store": "~13.0.2",
    "expo-sqlite": "~14.0.3",
    "expo-status-bar": "~1.12.1",
    "react": "18.2.0",
    "react-native": "0.74.5"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/react": "~18.2.79",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "~5.3.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json"
    ]
  },
  "private": true
}
