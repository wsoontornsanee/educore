# deploy/crontab — Canonical schedule for EduCore background jobs (ARC-013)
# Note: Server cron runs in UTC; each management command internally honors school timezones (ARC-014).
# Note: Production runs exactly one dedicated cron host (spec/01 §7). This file MUST only be
# installed on the host with EDUCORE_CRON_HOST=1 set — every command here refuses to run
# elsewhere (apps.core.management.base.CronHostCommand) unless passed --force.

* * * * *      python /app/manage.py drain_tasks --limit 200            # generic async queue
* * * * *      python /app/manage.py ingest_device_events               # edge agent event intake sweep
* * * * *      python /app/manage.py auto_submit_expired_exam_attempts  # ACD-025/026: force-submit past window_end
*/5 * * * *    python /app/manage.py refresh_reporting --scope=dashboard
*/5 * * * *    python /app/manage.py sync_payment_status                # poll pending payment intents
*/10 * * * *   python /app/manage.py check_device_health                # offline device alerts
*/15 * * * *   python /app/manage.py send_due_notifications             # scheduled + quiet-hours release
*/30 * * * *   python /app/manage.py send_wallet_recon_reminders        # 48h clock, delivered-notices only (spec/17 REC-012)
*/30 * * * *   python /app/manage.py process_wallet_auto_topups         # WAL-005/WAL-006 threshold-triggered VA/QRIS intents
0 * * * *      python /app/manage.py expire_sessions
0 5 * * *      python /app/manage.py pull_bank_statements --date=yesterday  # SFTP stub (CMP-024/026), fails loud
30 6 * * *     python /app/manage.py mark_absent_students               # after absent_cutoff per school
0 17 * * *     python /app/manage.py send_digests
0 18 * * *     python /app/manage.py reconcile_payments --date=today
0 19 * * *     python /app/manage.py reconcile_wallet_balances
0 20 * * *     python /app/manage.py refresh_reporting --scope=full
0 21 * * *     python /app/manage.py run_arrears_ladder
0 22 * * *     python /app/manage.py enforce_retention --retention-days=7  # idempotency key purge (spec/18 §4)
0 23 * * *     python /app/manage.py backup_database
0 1 * * *      python /app/manage.py invoice_stale_reconciliations      # 7d handover to arrears (spec/17 REC-013)
25 2 25 * *    python /app/manage.py generate_invoices --next-period
0 3 1 * *      python /app/manage.py close_metering_month
0 4 * * 0      python /app/manage.py settle_merchants
