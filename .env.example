# EduCore Environment Configuration Template
# Copy this file to .env and configure your values

# Django
DJANGO_SECRET_KEY=django-insecure-change-in-production
EDUCORE_USE_SQLITE=0

# MySQL 8.0 Database
EDUCORE_DB_HOST=127.0.0.1
EDUCORE_DB_PORT=3306
EDUCORE_DB_USER=root
EDUCORE_DB_PASSWORD=
EDUCORE_DB_NAME=educore
EDUCORE_TEST_DB_NAME=test_educore

# GCS file storage (ARC-026/ARC-030)
# GCS_CREDENTIALS_PATH must point to a service-account JSON kept OUTSIDE this repo —
# never commit that file. GCS_PATH_PREFIX is set per settings module (STG in base.py
# for local/staging, PRD in production.py) and normally does not need overriding here.
GCS_BUCKET_NAME=educore-e46aa.firebasestorage.app
GCS_CREDENTIALS_PATH=

# Google Workspace SSO (spec/14 §6, TASK-036)
# OAuth Client ID (Web application type) from Google Cloud Console, no secret needed —
# login uses the ID-token/JWKS flow (apps/identity/social_auth.py), not code exchange.
# Empty in a given environment = the Google button falls back to a manual token prompt.
GOOGLE_OAUTH_CLIENT_ID=

# Spending-PIN pepper (spec 18 QRS-029). Secret HMAC key applied to PIN hashes; keep it out of the DB.
# Production MUST set it (e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`). Changing it invalidates all PINs.
EDUCORE_PIN_PEPPER=
