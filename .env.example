# EduCore Environment Configuration Template
# Copy this file to .env and configure your values

# Django
DJANGO_SECRET_KEY=django-insecure-change-in-production
EDUCORE_USE_SQLITE=0

# MySQL 8.0 Database
EDUCORE_DB_HOST=127.0.0.1
EDUCORE_DB_PORT=3306
EDUCORE_DB_USER=root
EDUCORE_DB_PASSWORD=
EDUCORE_DB_NAME=educore
EDUCORE_TEST_DB_NAME=test_educore
